# Database
DATABASE_URL="mysql://dior:dior_secret@127.0.0.1:3306/dior_billing"
# Admin password applied on `pnpm db:seed` (upsert for admin@dior.cloud)
# ADMIN_SEED_PASSWORD=""

# Redis
REDIS_URL="redis://localhost:6379"

# Auth — generate: openssl rand -hex 32
JWT_SECRET="change-me-jwt-secret"
SESSION_SECRET="change-me-session-secret"
ENCRYPTION_KEY="change-me-32-byte-base64-key"

# Telegram (Login Widget + bot — same bot token, shared MySQL users.telegram_id)
# 1) Create bot via @BotFather, set domain: /setdomain → your production host
# 2) TELEGRAM_BOT_USERNAME = name without @ (e.g. DiorHostBot)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Admin alerts — Telegram "отстуки" for top-ups & new tickets (web billing /control)
# Get your chat ID: message the bot /chatid
TELEGRAM_ADMIN_CHAT_ID=""
# TELEGRAM_ADMIN_CHAT_IDS="123456789,987654321"
# Or user IDs from the panel — uses each user's linked Telegram (Settings → Integrations)
# TELEGRAM_ADMIN_USER_IDS="clxxx...,clyyy..."
# Set false to disable fallback to all staff with linked Telegram when lists above are empty
# TELEGRAM_ADMIN_NOTIFY_FALLBACK="false"
# TELEGRAM_ALERT_WORKER_LOOP=0  — disable recurring "Worker error" Telegram alerts
# Payment-only alerts (optional — overrides admin list for top-up notifications)
# PAYMENT_NOTIFY_TELEGRAM_IDS="123456789,987654321"
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# DISCORD_PAYMENT_WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""

# Cloudflare Turnstile — registration anti-bot (https://dash.cloudflare.com → Turnstile)
# Test keys below always pass in dev; replace with your widget keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# App URLs
NEXT_PUBLIC_APP_URL="https://my.dior.host"
NEXT_PUBLIC_MARKETING_URL="https://dior.host"
NEXT_PUBLIC_ADMIN_URL="https://my.dior.host"
NEXT_PUBLIC_API_URL="https://api.dior.host"
API_URL="https://api.dior.host"
# Referral cookie shared across dior.host + my.dior.host (production)
REFERRAL_COOKIE_DOMAIN=".dior.host"
# Comma-separated Telegram usernames excluded from revenue stats and referral commissions (default: diorhost)
# STATS_EXCLUDED_TELEGRAM_USERNAMES="diorhost"

# Proxmox (VPS provisioning)
VMM_EMAIL=
VMM_PASSWORD=
VMM_ENDPOINT_URL=
VM_PROVIDER=proxmox
PROXMOX_BASE_URL=
PROXMOX_NODE=pve01
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_STORAGE=storage-lvm
PROXMOX_BRIDGE=vmbr0
# TLS: Proxmox uses self-signed certs by default — keep INSECURE on unless you installed a real CA.
PROXMOX_INSECURE_TLS=1
# PROXMOX_VERIFY_TLS=1 — strict cert verify; PROXMOX_CA_CERT_PATH=/path/to/ca.pem — custom CA
PROXMOX_TEMPLATE_MAP={}
# Map EVERY OS you sell → Proxmox template VMID. Dropdown shows only mapped OSes.
# Discover: cd backend && pnpm exec tsx scripts/list-proxmox-templates.ts
# Example:
# PROXMOX_TEMPLATE_MAP={"debian11":901,"debian12":902,"debian13":903,"ubuntu2204":910,"ubuntu2404":911,"almalinux8":920,"almalinux9":921,"rockylinux9":922,"centos9":923,"winserver2019":930,"winserver2025":931,"winserver2012":932,"winserver2016":933,"windows10":934,"windows11":935,"freebsd":940}
# Empty map refuses provision unless:
# PROXMOX_ALLOW_TEMPLATE_FALLBACK=1
# Dev-only mock IP when Proxmox unset:
# PROXMOX_ALLOW_MOCK_PROVISION=1
# Optional: explicit IPv4 list. If unset, IPs auto-allocate from PROXMOX_NETWORK or Proxmox host subnet.
PROXMOX_IP_POOL=
PROXMOX_GATEWAY=
PROXMOX_NETWORK=
PROXMOX_IP_CIDR=24
# First host octet for web billing (optional). With strict gap-fill, allocation starts after highest known IP anyway.
# PROXMOX_IP_START=100
# PROXMOX_IP_END=250
# Strict gap-fill (default on): if Proxmox can't read IP from some VMs, block ALL gaps up to max known IP
# PROXMOX_IP_STRICT_GAP_FILL=0  — disable only if every VM has ipconfig0 or guest-agent
# Cloud-init login user on Linux templates (default root — must match panel "Username")
# PROXMOX_CIUSER=root
# VMID of a known-working VPS on this cluster (TG bot master-serv01 = 208) — billing mirrors net/hardware from it
# PROXMOX_REFERENCE_VMID=208
# Comma-separated VMIDs hidden from admin Services list (templates, etc.)
# PROXMOX_ADMIN_SKIP_VMIDS=9010,996
# Location code for IP pool (default nl-ams)
PROXMOX_IP_LOCATION=nl-ams

# Shared IP registry — same MySQL as DATABASE_URL (TG bot + billing)
# PROXMOX_REQUIRE_SHARED_IP_REGISTRY=1
# PROXMOX_NETWORK=45.74.7.0/24
# PROXMOX_GATEWAY=45.74.7.1
# Read-only SQL for Telegram bot VPS list (admin panel credentials + IP sync)
# TELEGRAM_BOT_SERVERS_SQL=SELECT id, vmid, ip, login, password, hostname, status, telegram_id FROM dior_bot.servers WHERE vmid IS NOT NULL
# Legacy IP-only query (still works if SERVERS_SQL unset):
# TELEGRAM_BOT_IPS_SQL=SELECT ip FROM dior_bot.servers WHERE ip IS NOT NULL AND status='active'
# SHARED_IP_REGISTRY=1
# PROXMOX_IP_START=100
# PROXMOX_IP_END=250
# SHARED_IP_RESERVE_TTL_MINUTES=30
# SHARED_IP_PROXMOX_SCAN_FALLBACK=0  — disable Proxmox scan during reserve (registry rows only)
# See docs/SHARED_IP_REGISTRY.md

# Amper — domain registrar API (token from Amper dashboard)
AMPER_API_BASE_URL=https://amper.lat/api/v1
AMPER_API_TOKEN=
AMPER_API_TIMEOUT_MS=30000

# Amper DNS (dns-node) — https://app.amper.network/docs  (X-Api-Key, prefix dnsn_)
AMPER_DNS_API_BASE_URL=https://app.amper.network/api/v1
AMPER_DNS_API_KEY=
AMPER_DNS_API_TIMEOUT_MS=20000
# Optional fallback NS if create-domain response omits nameservers
# AMPER_DNS_NAMESERVERS=ns1.dior.cloud,ns2.dior.cloud

# HostVDS / OpenStack (standard VPS — instant provision)
# Auth (from openrc) — AUTH_URL must include /v3
HOSTVDS_AUTH_URL=https://os-api.hostvds.com/identity/v3
HOSTVDS_USERNAME=
HOSTVDS_PASSWORD=
HOSTVDS_PROJECT_NAME=
HOSTVDS_USER_DOMAIN_NAME=Default
HOSTVDS_PROJECT_DOMAIN_NAME=Default
HOSTVDS_REGION_NAME=eu-west2
# Hide sold-out OpenStack regions (comma-separated). Empty string = show all.
# Default when unset: us-east2,asia-east1,eu-west1,eu-north2,asia-south1
# HOSTVDS_DISABLED_REGIONS=
# Optional static compute token instead of Keystone:
# HOSTVDS_API_BASE_URL=
# HOSTVDS_API_TOKEN=
# Optional Glance/Neutron bases if catalog missing (token mode):
# HOSTVDS_IMAGE_API_BASE_URL=
# HOSTVDS_NETWORK_API_BASE_URL=
HOSTVDS_API_TIMEOUT_MS=30000
HOSTVDS_POLL_INTERVAL_MS=5000
HOSTVDS_POLL_TIMEOUT_MS=600000
HOSTVDS_SSH_READY_TIMEOUT_MS=180000
HOSTVDS_SSH_SETTLE_MS=15000
# Network NAME (resolved via Neutron) — not a cross-region UUID
HOSTVDS_NETWORK_ID=Internet-03
HOSTVDS_SECURITY_GROUPS=allow_all
# HOSTVDS_CIUSER=root
# Map panel OS slug → Glance IMAGE NAME (not UUID)
# HOSTVDS_IMAGE_MAP={"ubuntu-24.04":"Ubuntu-24.04-amd64","debian-12":"Debian-12-amd64"}
# Map plan id → Nova FLAVOR NAME (not UUID)
# HOSTVDS_FLAVOR_MAP={"std-1":"hostvds-1","std-4":"highload-4"}
# Pricing (EUR cost → sell USD)
# HOSTVDS_COST_EUR_MAP={"std-1":0.99,"std-2":3.99,"std-3":3.99,"std-4":19.99,"std-5":39.99,"std-6":39.99,"std-7":39.99,"std-8":79.99,"std-9":119.99,"std-10":119.99}
HOSTVDS_EUR_USD=1
HOSTVDS_INSECURE_TLS=0

# Payment providers — balance top-up
TOPUP_EXPIRY_MINUTES=60

# Heleket (aliases: PAYMENT_HELEKET_* also supported)
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=
HELEKET_API_URL=https://api.heleket.com/v1
HELEKET_WEBHOOK_SECRET=
# PAYMENT_HELEKET_MERCHANT=
# PAYMENT_HELEKET_API_KEY=
# PAYMENT_HELEKET_API_URL=https://api.heleket.com

# Crypto Pay (@CryptoBot wallet — NOT your Dior login bot)
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_BOT_USERNAME=CryptoBot
NEXT_PUBLIC_CRYPTOBOT_BOT_USERNAME=CryptoBot
# PAYMENT_CRYPTOBOT_TOKEN=

# CrystalPay (aliases: PAYMENT_CRYSTALPAY_* also supported)
CRYSTALPAY_AUTH_LOGIN=
CRYSTALPAY_AUTH_SECRET=
CRYSTALPAY_CALLBACK_SECRET=
CRYSTALPAY_API_URL=https://api.crystalpay.io/v2
# PAYMENT_CRYSTALPAY_ID=
# PAYMENT_CRYSTALPAY_SECRET_ONE=
# PAYMENT_CRYSTALPAY_SECRET_TWO=

# Manual transfer support
NEXT_PUBLIC_MANUAL_SUPPORT_TELEGRAM="@your_support"